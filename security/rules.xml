<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="rule_timetable_academic" model="ir.rule">
        <field name="name">Academic Coordinator: Timetable of Assigned Batches</field>
        <field name="model_id" ref="model_otm_timetable"/>
        <field name="domain_force">[('batch_id.coordinator_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('student_details_19.group_academic_coordinator'))]"/>
    </record>
    <record id="rule_timetable_manager" model="ir.rule">
        <field name="name">Student Manager: All Timetable</field>
        <field name="model_id" ref="model_otm_timetable"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('student_details_19.group_student_manager'))]"/>
    </record>
</odoo>
